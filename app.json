{
  "expo": {
    "name": "Visomoot",
    "slug": "visomoot",
    "version": "0.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visomoot.mobile"
    },
    "android": {
      "package": "com.visomoot.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Visomoot utilise votre position pour afficher votre position sur la carte et enregistrer votre activité.",
          "locationAlwaysAndWhenInUsePermission": "Visomoot utilise votre position en arrière-plan pour continuer l’enregistrement quand l’écran est verrouillé.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
